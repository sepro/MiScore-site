{
  "name": "svelte-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "build:subfolder": "BASE_URL=/MiScore-site rollup -c",
    "dev": "rollup -c -w & sirv public --single --dev --port 8080",
    "dev:subfolder": "BASE_URL=/MiScore-site rollup -c -w",
    "start": "sirv public --no-clear --single --port 8081 --host",
    "start:subfolder": "sirv public --no-clear --single --port 8081 --host --base /MiScore-site"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^26.0.0",
    "@rollup/plugin-node-resolve": "^15.2.0",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^0.4.0",
    "rollup": "^4.21.0",
    "rollup-plugin-css-only": "^4.5.0",
    "rollup-plugin-livereload": "^2.0.0",
    "rollup-plugin-svelte": "^7.2.0",
    "svelte": "^4.2.20"
  },
  "dependencies": {
    "sirv-cli": "^2.0.0",
    "svelte-routing": "^2.13.0"
  }
}
